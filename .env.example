# Префикс для размещения в подпапке (GitHub Pages <user>.github.io/<repo>).
# На CI задаётся из имени репозитория; локально можно оставить пустым.
NEXT_PUBLIC_BASE_PATH=

# OAuth Client ID для опционального Google Drive Cloud Backup.
# Публичное значение (Web application client, browser-only flow GIS token
# model) — безопасно встраивается в статику. Client Secret в фронтенде
# не используется и сюда не вписывается.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
